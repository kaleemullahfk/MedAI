# MedAI Backend — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# Postgres example:
# DATABASE_URL=postgresql://medai:medai@localhost:5432/medai
# SQLite fallback (development):
DATABASE_URL=sqlite:///./medai.db

# --- Auth / JWT ---
# REQUIRED outside development. Use a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
# development | production | test
ENVIRONMENT=development
# Comma-separated allowed CORS origins (used only when the frontend
# calls the backend directly; the Next.js BFF makes same-origin calls).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# --- Uploads ---
# Absolute or repo-relative directory for uploaded reports/prescriptions.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Admin seeding (used by `python -m app.scripts.seed_admin`) ---
ADMIN_EMAIL=admin@medai.dev
ADMIN_PASSWORD=
